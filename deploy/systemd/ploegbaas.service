[Unit]
Description=Ploegbaas — dashboard om een ploeg AI-agenten aan het werk te zetten
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/opt/ploegbaas
Environment="PLOEGBAAS_POORT=8123"
Environment="PLOEGBAAS_DATA=/opt/ploegbaas/data"
Environment="PATH=/usr/local/bin:/usr/local/sbin:/usr/bin:/bin"
ExecStart=/usr/bin/node --no-warnings /opt/ploegbaas/server.mjs
Restart=always
RestartSec=5
KillMode=mixed
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
